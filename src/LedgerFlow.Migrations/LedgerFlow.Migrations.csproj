<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Базовое ядро FluentMigrator -->
    <PackageReference Include="FluentMigrator" Version="6.2.0" />
    <!-- Раннер, который умеет выполнять миграции в базах данных -->
    <PackageReference Include="FluentMigrator.Runner" Version="6.2.0" />
    <!-- Провайдер, переводящий C# код во Fluent-синтаксис PostgreSQL -->
    <PackageReference Include="FluentMigrator.Runner.Postgres" Version="6.2.0" />
  </ItemGroup>

</Project>